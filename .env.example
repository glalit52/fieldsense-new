# ---- Server ----
PORT=8787
DATA_DIR=./data

# ---- Agris assistant (Claude) ----
# Leave empty to use the built-in rule-based assistant.
ANTHROPIC_API_KEY=
AGRIS_MODEL=claude-opus-5-5

# ---- Google Earth Engine (optional, unlocks Sentinel-2/MODIS/CHIRPS/WorldCover/SoilGrids via GEE) ----
# Service-account JSON key file path, and the Cloud project registered for Earth Engine.
GEE_SERVICE_ACCOUNT_KEY_FILE=
GEE_PROJECT=

# ---- Copernicus Data Space / Sentinel Hub (optional, unlocks field-level Sentinel-2 NDVI/NDMI statistics) ----
# Create an OAuth client at https://shapps.dataspace.copernicus.eu/dashboard/
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ---- Extra weather providers (optional) ----
# Commercial Open-Meteo key: higher limits for production / batch use (free tier is ~600 calls/min, 10k/day).
OPEN_METEO_API_KEY=
OPENWEATHER_API_KEY=

# ---- Contact used in the User-Agent for Nominatim / ORNL and Support inquiries ----
CONTACT_EMAIL=lalit@sensegrass.com

# ---- Batch API Access (Optional: comma-separated list of keys) ----
API_KEYS=
