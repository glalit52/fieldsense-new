# Copy to .env for local development. On Railway, set these in the service's Variables tab instead.
# Everything is optional: with no keys at all FieldSense runs on free, keyless data sources.

# ---- Server ----
PORT=8787
# Interface to bind. "::" (default) takes IPv4 and IPv6.
HOST=
# Where the SQLite cache (and, without accounts, saved fields) lives. On Railway: /app/data (mount a volume there).
DATA_DIR=./data
LOG_LEVEL=info
# Browser origins allowed to call the API from other sites (comma-separated). Empty = same-origin only.
CORS_ORIGINS=

# ---- Accounts (optional) ----
# Setting MONGO_URI turns on sign-up/sign-in and private, per-user saved fields.
# Without it, saved fields live in local SQLite and are shared by everyone who can reach the server.
MONGO_URI=
# Required when MONGO_URI is set: at least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated emails that get the admin role (Admin page: users, roles, usage stats).
ADMIN_EMAILS=

# ---- Agris assistant (Claude) ----
# Leave empty to use the built-in rule-based assistant.
ANTHROPIC_API_KEY=
AGRIS_MODEL=claude-opus-5-5

# ---- Google Earth Engine (optional: Sentinel-2/MODIS/CHIRPS/WorldCover/SoilGrids via GEE) ----
# Either a path to the service-account JSON key file, or the JSON itself (easier on Railway).
GEE_SERVICE_ACCOUNT_KEY_FILE=
GEE_SERVICE_ACCOUNT_KEY=
GEE_PROJECT=

# ---- Copernicus Data Space / Sentinel Hub (optional: field-level Sentinel-2 NDVI/NDMI statistics) ----
# Create an OAuth client at https://shapps.dataspace.copernicus.eu/dashboard/
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ---- Extra weather providers (optional) ----
# Commercial Open-Meteo key: higher limits for production / batch use (free tier is ~600 calls/min, 10k/day).
OPEN_METEO_API_KEY=
OPENWEATHER_API_KEY=

# ---- Contact shown in the app and sent in the User-Agent to Nominatim / ORNL ----
CONTACT_EMAIL=lalit@sensegrass.com

# ---- Batch API (optional): comma-separated keys required in the x-api-key header of /api/v1/batch ----
API_KEYS=
